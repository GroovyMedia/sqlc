{
  "version": "2",
  "sql": [
    {
      "engine": "duckdb",
      "schema": "schema.sql",
      "queries": "query.sql",
      "gen": {
        "go": {
          "package": "querytest",
          "out": "go",
          "sql_package": "database/sql",
          "emit_pointers_for_null_types": true,
          "emit_json_tags": true,
          "build_tags": "cgo"
        }
      }
    }
  ]
}
